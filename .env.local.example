NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk server-side API routes (webhook, payment).
# TIDAK PERNAH diekspos ke browser (bukan NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=

EXPRESS_API_BASE_URL=http://localhost:4000
EXPRESS_INTERNAL_SECRET=dev-secret-ganti-di-prod

# Simulasi presentasi — proses Express TERPISAH (service/src/simulationIndex.js),
# isolasi proses dari course generation. Database tetap satu (Supabase yang sama).
SIMULATION_API_BASE_URL=http://localhost:4001
# Opsional: kosongkan untuk pakai EXPRESS_INTERNAL_SECRET yang sama.
SIMULATION_INTERNAL_SECRET=

# ── Midtrans Payment Gateway ──────────────────────────────────────────────────
# Dapatkan key di: https://dashboard.midtrans.com → Settings → Access Keys
# Untuk testing gunakan key Sandbox (prefix SB-).
# Ubah MIDTRANS_IS_PRODUCTION ke 'true' dan ganti ke Production key saat go-live.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# URL publik aplikasi Next.js ini — dipakai untuk callback URL setelah pembayaran.
# Untuk production: https://domainanda.com
# Untuk lokal pakai ngrok atau layanan tunnel agar Midtrans bisa kirim webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000
